{
  "version": 1,
  "subsystems": [
    {"name": "cli", "packages": ["github.com/StevenACoffman/anarch-lint", "github.com/StevenACoffman/anarch-lint/cmd/..."],
     "interface": ["github.com/StevenACoffman/anarch-lint/cmd/root"]},
    {"name": "presentation", "packages": ["github.com/StevenACoffman/anarch-lint/internal/text", "github.com/StevenACoffman/anarch-lint/internal/schema", "github.com/StevenACoffman/anarch-lint/internal/sarif"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/text", "github.com/StevenACoffman/anarch-lint/internal/schema", "github.com/StevenACoffman/anarch-lint/internal/sarif"]},
    {"name": "loading", "packages": ["github.com/StevenACoffman/anarch-lint/internal/gopackages"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/gopackages"]},
    {"name": "vcs", "packages": ["github.com/StevenACoffman/anarch-lint/internal/git"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/git"]},
    {"name": "domain-models", "packages": ["github.com/StevenACoffman/anarch-lint/internal/modelith"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/modelith"]},
    {"name": "ownership", "packages": ["github.com/StevenACoffman/anarch-lint/internal/codeowners"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/codeowners"]},
    {"name": "coverage", "packages": ["github.com/StevenACoffman/anarch-lint/internal/coverage"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/coverage"]},
    {"name": "fitness", "packages": ["github.com/StevenACoffman/anarch-lint/internal/fitness"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/fitness"]},
    {"name": "balance", "packages": ["github.com/StevenACoffman/anarch-lint/internal/balance"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/balance"]},
    {"name": "connascence", "packages": ["github.com/StevenACoffman/anarch-lint/internal/connascence"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/connascence"]},
    {"name": "domain", "packages": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "interface": ["github.com/StevenACoffman/anarch-lint/internal/arch"]}
  ],
  "subsystemOrder": ["cli", "presentation", "loading", "vcs", "domain-models", "ownership", "coverage", "fitness", "balance", "connascence", "domain"],
  "layers": [
    {"name": "command", "packages": ["github.com/StevenACoffman/anarch-lint", "github.com/StevenACoffman/anarch-lint/cmd/..."]},
    {"name": "adapter", "packages": ["github.com/StevenACoffman/anarch-lint/internal/text", "github.com/StevenACoffman/anarch-lint/internal/schema", "github.com/StevenACoffman/anarch-lint/internal/sarif",
      "github.com/StevenACoffman/anarch-lint/internal/gopackages", "github.com/StevenACoffman/anarch-lint/internal/git",
      "github.com/StevenACoffman/anarch-lint/internal/codeowners", "github.com/StevenACoffman/anarch-lint/internal/modelith", "github.com/StevenACoffman/anarch-lint/internal/coverage"]},
    {"name": "domain", "packages": ["github.com/StevenACoffman/anarch-lint/internal/arch",
      "github.com/StevenACoffman/anarch-lint/internal/connascence",
      "github.com/StevenACoffman/anarch-lint/internal/balance",
      "github.com/StevenACoffman/anarch-lint/internal/fitness"]}
  ],
  "isolations": [
    {"from": "github.com/StevenACoffman/anarch-lint/internal/connascence",
     "mayImport": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "reason": "a measure reads arch's facts and knows no adapter and no other measure; only cmd wires them (summary_rules §1, §5)"},
    {"from": "github.com/StevenACoffman/anarch-lint/internal/balance",
     "mayImport": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "reason": "a measure reads arch's facts and knows no adapter and no other measure; only cmd wires them (summary_rules §1, §5)"},
    {"from": "github.com/StevenACoffman/anarch-lint/internal/fitness",
     "mayImport": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "reason": "a measure reads arch's facts and knows no adapter and no other measure; only cmd wires them (summary_rules §1, §5)"},
    {"from": "github.com/StevenACoffman/anarch-lint/internal/modelith",
     "mayImport": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "reason": "adapters do not import each other; only cmd wires them (summary_rules §1)"},
    {"from": "github.com/StevenACoffman/anarch-lint/internal/codeowners",
     "mayImport": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "reason": "adapters do not import each other; only cmd wires them (summary_rules §1)"},
    {"from": "github.com/StevenACoffman/anarch-lint/internal/coverage",
     "mayImport": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "reason": "adapters do not import each other; only cmd wires them (summary_rules §1)"},
    {"from": "github.com/StevenACoffman/anarch-lint/internal/sarif",
     "mayImport": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "reason": "adapters do not import each other; only cmd wires them (summary_rules §1)"}
  ],
  "forbiddenImports": [
    {"from": ["github.com/StevenACoffman/anarch-lint/internal/arch"],
     "imports": ["os", "os/...", "time", "math/rand"],
     "reason": "the domain is a pure functional core: no I/O, no clock, no global randomness (mmi-plan.md §2); a seeded math/rand/v2 source is deterministic, and its libraries are approved by core-approved-libraries (docs/adr/0012)"},
    {"from": ["github.com/StevenACoffman/anarch-lint/internal/connascence", "github.com/StevenACoffman/anarch-lint/internal/balance", "github.com/StevenACoffman/anarch-lint/internal/fitness"],
     "imports": ["os", "os/...", "time", "math/rand"],
     "reason": "a measure is a pure functional core like the domain: no I/O, no clock, no global randomness (mmi-plan.md §2); its libraries are approved by core-approved-libraries (docs/adr/0012)"},
    {"from": ["github.com/StevenACoffman/anarch-lint/internal/gopackages"],
     "imports": ["github.com/StevenACoffman/anarch-lint/internal/git", "github.com/StevenACoffman/anarch-lint/internal/text", "github.com/StevenACoffman/anarch-lint/internal/codeowners", "github.com/StevenACoffman/anarch-lint/internal/modelith", "github.com/StevenACoffman/anarch-lint/internal/sarif", "github.com/StevenACoffman/anarch-lint/internal/coverage"],
     "reason": "adapters do not import each other; only cmd wires them (summary_rules §1)"},
    {"from": ["github.com/StevenACoffman/anarch-lint/internal/git"],
     "imports": ["github.com/StevenACoffman/anarch-lint/internal/gopackages", "github.com/StevenACoffman/anarch-lint/internal/text", "github.com/StevenACoffman/anarch-lint/internal/codeowners", "github.com/StevenACoffman/anarch-lint/internal/modelith", "github.com/StevenACoffman/anarch-lint/internal/sarif", "github.com/StevenACoffman/anarch-lint/internal/coverage"],
     "reason": "adapters do not import each other; only cmd wires them (summary_rules §1)"},
    {"from": ["github.com/StevenACoffman/anarch-lint/internal/text"],
     "imports": ["github.com/StevenACoffman/anarch-lint/internal/gopackages", "github.com/StevenACoffman/anarch-lint/internal/git", "github.com/StevenACoffman/anarch-lint/internal/codeowners", "github.com/StevenACoffman/anarch-lint/internal/modelith", "github.com/StevenACoffman/anarch-lint/internal/sarif", "github.com/StevenACoffman/anarch-lint/internal/coverage"],
     "reason": "adapters do not import each other; only cmd wires them (summary_rules §1)"}
  ],
  "connascence": {
    "maxStrength": {"package": 9, "subsystem": 5, "system": 3, "external": 2}
  },
  "balance": {"gate": true},
  "fitness": {
    "requireAssigned": true,
    "layerAccess": [
      {"name": "pure-domain", "layer": "domain", "mayNotAccessAny": true, "consideringAll": true,
       "reason": "the domain and the measures depend on nothing but themselves (summary_rules §5)"},
      {"name": "adapters-to-domain", "layer": "adapter", "mayOnlyAccess": ["domain"],
       "reason": "an adapter translates for the domain and knows no command (summary_rules §1)"}
    ],
    "calls": [
      {"name": "no-clock-or-os-in-core",
       "from": ["github.com/StevenACoffman/anarch-lint/internal/arch", "github.com/StevenACoffman/anarch-lint/internal/connascence", "github.com/StevenACoffman/anarch-lint/internal/balance", "github.com/StevenACoffman/anarch-lint/internal/fitness"],
       "callees": ["time.Now", "time.Since", "os.*", "(*os.File).*", "math/rand.*",
         "math/rand/v2.ExpFloat64", "math/rand/v2.Float32", "math/rand/v2.Float64", "math/rand/v2.Int", "math/rand/v2.Int32", "math/rand/v2.Int32N", "math/rand/v2.Int64", "math/rand/v2.Int64N", "math/rand/v2.IntN", "math/rand/v2.N", "math/rand/v2.NormFloat64", "math/rand/v2.Perm", "math/rand/v2.Shuffle", "math/rand/v2.Uint", "math/rand/v2.Uint32", "math/rand/v2.Uint32N", "math/rand/v2.Uint64", "math/rand/v2.Uint64N", "math/rand/v2.UintN"],
       "reason": "the functional core reads no clock, does no I/O and draws nothing from the global random source; a source seeded with constants, as Louvain's, is deterministic"}
    ],
    "libraries": [
      {"name": "core-approved-libraries",
       "from": ["github.com/StevenACoffman/anarch-lint/internal/arch", "github.com/StevenACoffman/anarch-lint/internal/connascence", "github.com/StevenACoffman/anarch-lint/internal/balance", "github.com/StevenACoffman/anarch-lint/internal/fitness"],
       "allow": ["gonum.org/v1/gonum/...", "github.com/bmatcuk/doublestar/v4", "github.com/agnivade/levenshtein"],
       "reason": "the core imports only pure, deterministic, well-tested libraries, each approved here (docs/adr/0012)"}
    ],
    "dependents": [
      {"name": "x-tools-only-in-loader", "packages": ["golang.org/x/tools/..."],
       "onlyFrom": ["github.com/StevenACoffman/anarch-lint/internal/gopackages", "github.com/StevenACoffman/anarch-lint/internal/coverage"],
       "reason": "go/packages is the loader's dependency, and cover the coverage reader's (summary_rules §1)"}
    ],
    "domains": [
      {"name": "core-speaks-its-model", "path": "anarch-lint.modelith.yaml", "subsystem": "domain",
       "reason": "the functional core keeps the vocabulary of its domain model (docs/adr/0005)"}
    ]
  }
}
