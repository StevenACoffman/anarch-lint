  "assumptions": [
    {
      "id": "strength-order",
      "text": "Strengths follow connascence.io: name 1, type 2, meaning 3, position 4, algorithm 5, execution 6, timing 7, value 8, identity 9. coupling.dev ranks position above algorithm; only a maxStrength limit of 4 would decide differently.",
      "source": "connascence.md §1.1, §9.1"
    },
    {
      "id": "default-limits",
      "text": "maxStrength defaults to 9 up to the package, 5 across subsystems, 3 across a module and 2 beyond it; no degree limit applies unless the model sets one. Borrowed guidance from connascence.io's locality principle, not a formula.",
      "source": "connascence.md §1.4"
    },
    {
      "id": "locality",
      "text": "arch.Locality is the first of function, type, file, package, subsystem, system (one Go module) and external that holds every site; degree counts the distinct entities one level below it.",
      "source": "connascence.md §1.2, §1.3"
    },
    {
      "id": "degree-ratchet",
      "text": "check ratchets the degree of each fact of meaning or stronger at a subsystem boundary or beyond; the degree of name and type may grow, as ordinary use of an exported name does.",
      "source": "connascence.md §2.1, §6"
    },
    {
      "id": "facts-and-candidates",
      "text": "Facts gate; candidates never do until an approved verdict confirms them, and an approved rejection sets them aside until their evidence changes.",
      "source": "connascence.md §5"
    },
    {
      "id": "excluded-values",
      "text": "The values 0, 1, -1 and \"\" carry no meaning of their own and are left out of the value detectors; arguments to fmt, errors, log, log/slog and testing are messages and are left out too.",
      "source": "connascence.md §2.3"
    },
    {
      "id": "parameter-threshold",
      "text": "A parameter list of 4 or more is connascence of position; runs of two or more adjacent parameters of one basic type are candidates of meaning.",
      "source": "connascence.md §2.3, §2.4"
    },
    {
      "id": "lifecycle-pairs",
      "text": "Lifecycle pairs are Open/Close, Start/Stop, Connect/Disconnect and Begin/Commit.",
      "source": "connascence.md §3.1"
    },
    {
      "id": "registrations",
      "text": "Registration functions are net/http's Handle and HandleFunc and the flag package's definitions, keyed by their route or flag name; two calls may use different instances, so collisions are candidates.",
      "source": "connascence.md §3.5"
    },
    {
      "id": "read-only-variables",
      "text": "An exported variable that no function writes, such as a sentinel error, is connascence of identity only as a candidate: it behaves as a constant.",
      "source": "connascence.md §3.4"
    },
    {
      "id": "clones",
      "text": "Clones are function bodies of 10 or more statements with the same shape once names and literal values are removed; a rule re-implemented in different code is missed.",
      "source": "connascence.md §2.5, §9.2"
    },
    {
      "id": "partial-clones",
      "text": "Partial clones are github.com/golangci/dupl's: runs of statements, each of at least 60 syntax-tree nodes, repeated in two or more packages, found with facts only. Copies that are whole functions of one shape are left to the clones detector.",
      "source": "connascence.md §2.5; IMPROVEMENTS.md 9.1"
    },
    {
      "id": "site-cap",
      "text": "An instance lists its first 20 sites in sorted order; siteCount gives the total.",
      "source": "connascence.md §6"
    }
  ]
}
